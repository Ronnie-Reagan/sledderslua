SLEDDERS LUA API 3.2
Runtime 0.5.0-dev

DESIGN NOTES
  Stable APIs expose Sledders/game concepts and safe Unity-backed wrappers.
  Most writable state has matching get/set access. Derived telemetry stays read-only.
  Stable object wrappers are handle-based and become invalid after their scene/object lifetime ends.
  Angles are degrees. Positions/distances are metres. Velocity is m/s. Force is newtons.
  Fuel is litres. Rigidbody mass/vehicle definition weight are kilograms but are separate concepts.
  Numeric setters reject NaN and infinity.

CALLBACKS
  onLoad()
  onUnload(reason)
  onTick(dt)
  onFixedTick(dt)
  onLateTick(dt)
  onDraw()
  onKey(key)
  onSledReady()
  onSledChanged()
  onSledLost()
  onSceneLoaded(index, name)
  onSceneInitialized(index, name)
  onSceneUnloaded(index, name)

API  sledders.api
  version : String
  runtimeVersion : String
  has(capability) -> bool

  Common capabilities:
    sled, sled.physics, sled.vehicle, sled.tuning, sled.visuals
    player, camera, camera.projection, camera.free, camera.photo
    hud, audio, audio.sources, audio.wav, audio.native_sfx, audio.presets
    visual.materials, scene, scene.objects, physics, physics.queries
    assets, assets.bundles, input.native
    world, world.snow, world.weather, world.time, world.fuel
    storage, dev

MOD  sledders.mod
  id : String
  name : String
  version : String
  author : String

PLAYER  sledders.player
  getSled() -> Sled|nil
  hasSled() -> bool
  getPos() -> Vector3|nil
  setPos(Vector3 | x,y,z) -> bool
  getRot() -> Vector3|nil                 Euler degrees
  setRot(Vector3 | x,y,z) -> bool
  getTransform() -> Transform|nil
  getRenderers(max?) -> Array<Renderer>
  getState() -> PropertyBag|nil

  player state keys currently include:
    bodyOffset, drivingStance, switchbackStance, isPerformingAction,
    handRotationWeight, shoulderDefaultWeight, shoulderTargetWeight,
    shoulderMaxWeight, shoulderWeightFactor, shoulderSmoothSpeed

SLED  returned by sledders.player.getSled() / sledders.sled.getAll()
  isValid() -> bool
  getName() -> String|nil

  getPos() -> Vector3|nil
  setPos(Vector3 | x,y,z) -> bool          direct move; does not use respawn path
  teleport(Vector3 | x,y,z, preserveVelocity?) -> bool
  getRot() -> Vector3|nil
  setRot(Vector3 | x,y,z) -> bool

  getVel() -> Vector3|nil                 sled-local velocity
  setVel(Vector3 | right,up,forward) -> bool
  getWorldVel() -> Vector3|nil
  setWorldVel(Vector3 | x,y,z) -> bool
  getAngularVel() -> Vector3|nil
  setAngularVel(Vector3 | x,y,z) -> bool
  getForwardSpeed() -> Number|nil
  getSpeed() -> Number|nil

  getMass() -> Number|nil                 live main Rigidbody mass
  setMass(kg) -> bool
  getBody() -> Rigidbody|nil
  getVehicle() -> Vehicle|nil
  getTuning() -> SledTuning
  getStructure() -> SledStructure|nil
  getRenderers(group?) -> Array<Renderer>

  addForce(Vector3 | right,up,forward) -> bool
  addWorldForce(Vector3 | x,y,z) -> bool
  addTorque(Vector3 | localX,localY,localZ) -> bool
  addWorldTorque(Vector3 | x,y,z) -> bool

  getHeadlights() -> bool|nil
  setHeadlights(enabled) -> bool
  toggleHeadlights() -> bool
  forceHeadlights(enabled) -> bool         owner-scoped persistent override
  areHeadlightsForced() -> bool
  releaseHeadlights() -> bool

  getRpm() -> Number|nil
  getRPM() -> Number|nil                  compatibility alias
  getDisplayRpm() -> Number|nil
  getTrackSpeed() -> Number|nil
  getThrottle() -> Number|nil

  isEngineOn() -> bool|nil
  setEngineOn(enabled) -> bool
  startEngine() -> bool
  stopEngine() -> bool

  getFuel() -> Number|nil                 litres
  getFuelCapacity() -> Number|nil         litres
  getFuelPercent() -> Number|nil          0..1
  setFuel(litres) -> bool
  addFuel(litres) -> bool
  fillFuel() -> bool
  isFuelEmpty() -> bool|nil

  getParking()/setParking(enabled) -> bool|nil / bool
  getFrozen()/setFrozen(enabled) -> bool|nil / bool
  getVisible()/setVisible(enabled) -> bool|nil / bool
  isDead() -> bool|nil
  isInAir() -> bool|nil
  isWheelie() -> bool|nil
  getClientId() -> String|nil             string preserves full 64-bit value

SLEDS  sledders.sled
  getAll(max?) -> Array<Sled>

RIGIDBODY  sled:getBody()
  PropertyBag methods plus convenience methods.
  keys() -> Array<String>
  isWritable(key) -> bool|nil
  get(key) -> Any
  set(key, value) -> bool

  writable keys:
    mass, position, rotation, velocity, angularVelocity, centerOfMass,
    linearDamping, angularDamping, useGravity, isKinematic,
    maxAngularVelocity, sleepThreshold, solverIterations,
    solverVelocityIterations, collisionDetectionMode, interpolation

  getMass()/setMass(value)
  getVelocity()/setVelocity(Vector3)
  getAngularVelocity()/setAngularVelocity(Vector3)
  getCenterOfMass()/setCenterOfMass(Vector3)
  getLinearDamping()/setLinearDamping(value)
  getAngularDamping()/setAngularDamping(value)
  getUseGravity()/setUseGravity(bool)
  getKinematic()/setKinematic(bool)
  getPos()/setPos(Vector3)
  getRot()/setRot(Vector3)
  addForce(Vector3) -> bool
  addTorque(Vector3) -> bool
  wake() -> bool
  sleep() -> bool
  resetMotion() -> bool

VEHICLE  sled:getVehicle()
  Semantic PropertyBag around VehicleScriptableObject.
  keys(), isWritable(key), get(key), set(key,value)

  convenience getter/setter pairs:
    Name, Description, Weight, Horsepower, MaxRpm, FuelCapacity,
    FuelConsumption, Friction, LugHeight, SkiStance, PowerFactor,
    Turbo, CenterOfMassOffset, DriverCenterOfMassOffset, EngineAudioType

  additional writable keys:
    prefabName, group, category, locked, engineText, lengthName,
    lengthIndex, skiDistanceOffset, hasBarpads, hasHandleGuards,
    hasWindshield, hasSnowFlaps, hasHighHandlebar,
    hasDefaultHandleGuards, hasRemovableRearParts, hasTunnelAccessories,
    canChangeSkis, canChangeBumpers, canChangeSpindle, canChangeHandlebar

  Note: vehicle.weight is the vehicle-definition value. body.mass is live physics mass.

SLED TUNING  sled:getTuning()
  getController() -> PropertyBag
  getBase() -> PropertyBag|nil
  getSuspension() -> PropertyBag|nil
  getShock("front"|"rear") -> Shock|nil

  controller keys:
    throttleExponent, driverTorqueRoll, driverTorquePitch, sledTorque,
    fuelConsumptionEnabled, fuelUsageMultiplier, rpmSensitivity,
    rpmSensitivityDown, rpmSoundVariation, minThrottleOnClutchEngagement,
    clutchRpmMin, clutchRpmMax, wheelieThreshold, drowningDepth, drowningTime

  base keys:
    skisMaxAngle, verticalWeightTransfer, horizontalWeightTransferMode,
    toeAngle, driverLowStanceTargetY, switchbackJump, hopOverPreJump,
    switchBackLeanDistance, trailLeanDistance, switchbackTransitionTime

  suspension keys:
    subSteps, interpolatedTerrainNormals, debugGraph, antiRollBarFactor,
    skiAutoTurn, uniformTrackFrictionVelocity, clampTrackSideFriction,
    trackRigidityFront, trackRigidityRear, tiltFrictionMode,
    reduceSuspensionForceByTilt, reduceSkiGripForceByTilt,
    reduceTrackGripForceByTilt

SHOCK
  PropertyBag keys: mass, maxCompression, compression, velocity, averageVelocity
  getSoft() -> PropertyBag|nil
  getHard() -> PropertyBag|nil
  reset() -> bool

SHOCK SETTINGS
  keys: springFactor, damperFactor, fastCompressionVelocityThreshold,
        fastReboundVelocityThreshold, compressionRatio,
        compressionFastRatio, reboundRatio, reboundFastRatio

