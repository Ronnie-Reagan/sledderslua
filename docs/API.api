AUDIO  sledders.audio
  getVolume()/setVolume(value)                  global AudioListener 0..1
  getSources(max?) -> Array<AudioSource>
  getPlayingSources(max?) -> Array<AudioSource>
  getSledSources(max?) -> Array<AudioSource>
  loadWav(relativePath) -> AudioClip|nil
  createSource(options?) -> AudioSource|nil
  play(AudioClip, options?) -> AudioSource|nil
  nativeSfx : NativeSfx
  engine : EngineAudio
  presets : AudioPresets

  WAV loader is sandboxed to the mod directory and supports PCM 8/16/24/32-bit
  and IEEE float 32-bit WAV files up to 64 MiB.

AUDIO SOURCE
  isValid() -> bool
  getName() -> String
  getVolume()/setVolume(0..1)
  getPitch()/setPitch(-3..3)
  getTime()/setTime(seconds)
  getSpatialBlend()/setSpatialBlend(0..1)
  getLoop()/setLoop(bool)
  getMute()/setMute(bool)
  isPlaying() -> bool|nil
  getClip()/setClip(AudioClip)
  getPos()/setPos(Vector3)
  play()/pause()/unPause()/stop() -> bool

